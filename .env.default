MONGODB_URI=mongodb://localhost:27017/shareyourgarden
# OAuth 2.0 Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
# Secret used to sign the backend JWT (HS256). Generate with: openssl rand -base64 48
JWT_SECRET=
# Comma-separated list of allowed web origins. `*` matches part of one host
# label, e.g. https://deploy-preview-*--shareyourgarden.netlify.app
CORS_ORIGINS=http://localhost:3000
# Web Push (VAPID) keys for message notifications. Optional: without them push
# is off and /push/* returns 503. Generate a pair with: yarn vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, as a mailto: URL
VAPID_SUBJECT=mailto:
# Product photos (optional): an S3-compatible bucket such as Cloudflare R2.
# Without these the app runs with photos disabled. See README.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the bucket is served from, without a trailing slash
PUBLIC_ASSETS_URL=
